{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "value",
        "constraint",
        "add-constraint",
        "state",
        "transition"
      ]
    },
    "nodeId": {
      "type": "string",
      "maxLength": 80
    },
    "targetId": {
      "type": "string",
      "maxLength": 80
    },
    "targetIds": {
      "default": [],
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "detail": {
      "type": "string",
      "maxLength": 800
    },
    "changes": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 1200
          },
          "stateId": {
            "type": "string",
            "maxLength": 80
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "required": [
          "key",
          "stateId",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "reply": {
      "type": "string",
      "maxLength": 400
    }
  },
  "required": [
    "kind",
    "nodeId",
    "targetId",
    "targetIds",
    "title",
    "detail",
    "changes",
    "reply"
  ],
  "additionalProperties": false
}
