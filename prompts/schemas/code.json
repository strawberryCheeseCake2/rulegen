{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 150
    },
    "explanation": {
      "type": "string",
      "maxLength": 1000
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120000
    }
  },
  "required": [
    "title",
    "explanation",
    "code"
  ],
  "additionalProperties": false
}
