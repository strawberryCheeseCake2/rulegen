{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "axis": {
      "type": "string",
      "enum": [
        "run",
        "input",
        "steps"
      ]
    },
    "from": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "to": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "edits": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "maxLength": 80
          },
          "find": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "replace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "required": [
          "nodeId",
          "find",
          "replace"
        ],
        "additionalProperties": false
      }
    },
    "overlays": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "rect",
              "ellipse",
              "line",
              "label"
            ]
          },
          "name": {
            "default": "",
            "type": "string",
            "maxLength": 60
          },
          "x": {
            "type": "string",
            "maxLength": 400
          },
          "y": {
            "type": "string",
            "maxLength": 400
          },
          "w": {
            "type": "string",
            "maxLength": 400
          },
          "h": {
            "type": "string",
            "maxLength": 400
          },
          "label": {
            "type": "string",
            "maxLength": 300
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "link": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "param",
                  "constraint",
                  "state",
                  "transition",
                  "parameter"
                ]
              },
              "nodeId": {
                "type": "string",
                "maxLength": 80
              },
              "id": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "kind",
              "nodeId",
              "id"
            ],
            "additionalProperties": false
          },
          "when": {
            "default": "",
            "type": "string",
            "maxLength": 400
          },
          "each": {
            "default": "",
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "x",
          "y",
          "w",
          "h",
          "label",
          "color",
          "link",
          "when",
          "each"
        ],
        "additionalProperties": false
      }
    },
    "stages": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "explain": {
            "type": "string",
            "maxLength": 300
          },
          "of": {
            "default": [],
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "constraint",
                    "state",
                    "transition"
                  ]
                },
                "nodeId": {
                  "type": "string",
                  "maxLength": 80
                },
                "id": {
                  "type": "string",
                  "maxLength": 80
                }
              },
              "required": [
                "kind",
                "nodeId",
                "id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "op",
          "name",
          "explain",
          "of"
        ],
        "additionalProperties": false
      }
    },
    "of": {
      "default": [],
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "constraint",
              "state",
              "transition"
            ]
          },
          "nodeId": {
            "type": "string",
            "maxLength": 80
          },
          "id": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "kind",
          "nodeId",
          "id"
        ],
        "additionalProperties": false
      }
    },
    "sketches": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "shape": {
            "type": "string",
            "enum": [
              "x",
              "circle",
              "arrow",
              "cut",
              "line",
              "tap",
              "check",
              "scribble",
              "trace",
              "custom"
            ]
          },
          "x": {
            "type": "string",
            "maxLength": 400
          },
          "y": {
            "type": "string",
            "maxLength": 400
          },
          "w": {
            "type": "string",
            "maxLength": 400
          },
          "h": {
            "type": "string",
            "maxLength": 400
          },
          "toX": {
            "type": "string",
            "maxLength": 400
          },
          "toY": {
            "type": "string",
            "maxLength": 400
          },
          "path": {
            "type": "string",
            "maxLength": 200
          },
          "template": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          },
          "hint": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "op",
          "shape",
          "x",
          "y",
          "w",
          "h",
          "toX",
          "toY",
          "path",
          "template",
          "hint"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "axis",
    "from",
    "to",
    "edits",
    "overlays",
    "stages",
    "of",
    "sketches"
  ],
  "additionalProperties": false
}
