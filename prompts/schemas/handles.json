{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "handles": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "propertyId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "paths": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          },
          "hint": {
            "type": "string",
            "maxLength": 120
          },
          "code": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "required": [
          "propertyId",
          "paths",
          "hint",
          "code"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "handles"
  ],
  "additionalProperties": false
}
