{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "overlays": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "rect",
              "ellipse",
              "line",
              "label"
            ]
          },
          "name": {
            "default": "",
            "type": "string",
            "maxLength": 60
          },
          "x": {
            "type": "string",
            "maxLength": 400
          },
          "y": {
            "type": "string",
            "maxLength": 400
          },
          "w": {
            "type": "string",
            "maxLength": 400
          },
          "h": {
            "type": "string",
            "maxLength": 400
          },
          "label": {
            "type": "string",
            "maxLength": 300
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "link": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "constraint",
                  "state",
                  "transition",
                  "parameter"
                ]
              },
              "nodeId": {
                "type": "string",
                "maxLength": 80
              },
              "id": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "kind",
              "nodeId",
              "id"
            ],
            "additionalProperties": false
          },
          "when": {
            "default": "",
            "type": "string",
            "maxLength": 400
          },
          "each": {
            "default": "",
            "type": "string",
            "maxLength": 200
          },
          "handle": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "maxLength": 1200
                  },
                  "gesture": {
                    "type": "string",
                    "enum": [
                      "drag",
                      "rotate",
                      "slide",
                      "move"
                    ]
                  },
                  "x": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "y": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "pivotX": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "pivotY": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 600
                  },
                  "hint": {
                    "type": "string",
                    "maxLength": 80
                  }
                },
                "required": [
                  "key",
                  "gesture",
                  "x",
                  "y",
                  "pivotX",
                  "pivotY",
                  "value",
                  "hint"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "x",
          "y",
          "w",
          "h",
          "label",
          "color",
          "link",
          "when",
          "each",
          "handle"
        ],
        "additionalProperties": false
      }
    },
    "valueFixes": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 1200
          },
          "stateId": {
            "type": "string",
            "maxLength": 80
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "boolean"
              }
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "key",
          "stateId",
          "value",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "recommendations": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "value",
              "transformation",
              "add-transformation",
              "state",
              "transition"
            ]
          },
          "nodeId": {
            "type": "string",
            "maxLength": 80
          },
          "targetId": {
            "type": "string",
            "maxLength": 80
          },
          "targetIds": {
            "default": [],
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "detail": {
            "type": "string",
            "maxLength": 800
          },
          "changes": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "maxLength": 1200
                },
                "stateId": {
                  "type": "string",
                  "maxLength": 80
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "required": [
                "key",
                "stateId",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "kind",
          "nodeId",
          "targetId",
          "targetIds",
          "title",
          "detail",
          "changes"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {
      "default": [],
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string",
            "maxLength": 80
          },
          "transformationId": {
            "type": "string",
            "maxLength": 80
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "effect": {
            "type": "string",
            "enum": [
              "spatial",
              "stylistic",
              "temporal"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 600
          },
          "form": {
            "default": "constant",
            "type": "string",
            "enum": [
              "constant",
              "scale"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "number"
                  },
                  "value": {
                    "type": "number"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "step": {
                    "type": "number",
                    "minimum": 1e-8
                  },
                  "unit": {
                    "type": "string",
                    "maxLength": 20
                  }
                },
                "required": [
                  "type",
                  "value",
                  "min",
                  "max",
                  "step",
                  "unit"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "color"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "select"
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "options": {
                    "minItems": 2,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  }
                },
                "required": [
                  "type",
                  "value",
                  "options"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "toggle"
                  },
                  "value": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 400
          },
          "edits": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "find": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1500
                },
                "replace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "find",
                "replace"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "nodeId",
          "transformationId",
          "id",
          "label",
          "effect",
          "description",
          "form",
          "value",
          "reason",
          "edits"
        ],
        "additionalProperties": false
      }
    },
    "records": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "nodeId": {
              "type": "string",
              "maxLength": 80
            },
            "fields": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[A-Za-z_$][\\w$]*$"
              }
            },
            "perItem": {
              "default": [],
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              }
            },
            "reason": {
              "type": "string",
              "maxLength": 400
            },
            "edits": {
              "minItems": 1,
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "find": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1500
                  },
                  "replace": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  }
                },
                "required": [
                  "find",
                  "replace"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "nodeId",
            "fields",
            "perItem",
            "reason",
            "edits"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "summary",
    "overlays",
    "valueFixes",
    "recommendations",
    "parameters",
    "records"
  ],
  "additionalProperties": false
}
