{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "overlays": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "rect",
              "ellipse",
              "line",
              "label"
            ]
          },
          "name": {
            "default": "",
            "type": "string",
            "maxLength": 60
          },
          "x": {
            "type": "string",
            "maxLength": 400
          },
          "y": {
            "type": "string",
            "maxLength": 400
          },
          "w": {
            "type": "string",
            "maxLength": 400
          },
          "h": {
            "type": "string",
            "maxLength": 400
          },
          "label": {
            "type": "string",
            "maxLength": 300
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "link": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "constraint",
                  "state",
                  "transition"
                ]
              },
              "nodeId": {
                "type": "string",
                "maxLength": 80
              },
              "id": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "kind",
              "nodeId",
              "id"
            ],
            "additionalProperties": false
          },
          "when": {
            "default": "",
            "type": "string",
            "maxLength": 400
          },
          "each": {
            "default": "",
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "x",
          "y",
          "w",
          "h",
          "label",
          "color",
          "link",
          "when",
          "each"
        ],
        "additionalProperties": false
      }
    },
    "valueFixes": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 1200
          },
          "stateId": {
            "type": "string",
            "maxLength": 80
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "boolean"
              }
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "key",
          "stateId",
          "value",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "recommendations": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "value",
              "transformation",
              "state",
              "transition"
            ]
          },
          "nodeId": {
            "type": "string",
            "maxLength": 80
          },
          "targetId": {
            "type": "string",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "detail": {
            "type": "string",
            "maxLength": 800
          },
          "changes": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "maxLength": 1200
                },
                "stateId": {
                  "type": "string",
                  "maxLength": 80
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "required": [
                "key",
                "stateId",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "kind",
          "nodeId",
          "targetId",
          "title",
          "detail",
          "changes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "overlays",
    "valueFixes",
    "recommendations"
  ],
  "additionalProperties": false
}
