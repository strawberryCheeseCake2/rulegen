{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "reading": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "hint": {
      "type": "string",
      "maxLength": 80
    },
    "params": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,23}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "type": {
            "type": "string",
            "enum": [
              "number",
              "color",
              "select",
              "toggle"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "boolean"
              }
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "options": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        },
        "required": [
          "id",
          "label",
          "type",
          "value",
          "min",
          "max",
          "step",
          "options"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "aspect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "expr": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "aspect",
          "expr"
        ],
        "additionalProperties": false
      }
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    }
  },
  "required": [
    "reading",
    "hint",
    "params",
    "rules",
    "code"
  ],
  "additionalProperties": false
}
