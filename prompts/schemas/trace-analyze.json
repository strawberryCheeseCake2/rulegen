{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 800
    },
    "cycleCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "sites": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "maxLength": 200
          },
          "note": {
            "type": "string",
            "maxLength": 300
          },
          "show": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "locate": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "range": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "site",
          "note",
          "show",
          "locate",
          "range"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "cycleCount",
    "sites"
  ],
  "additionalProperties": false
}
