{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "plans": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "maxLength": 200
          },
          "code": {
            "type": "string",
            "maxLength": 12000
          },
          "skipReason": {
            "type": "string",
            "maxLength": 300
          },
          "accumulate": {
            "type": "boolean"
          }
        },
        "required": [
          "site",
          "code",
          "skipReason",
          "accumulate"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "plans"
  ],
  "additionalProperties": false
}
